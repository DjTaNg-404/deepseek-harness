# CodeBuddy 桥与 DSH 的启停环境变量。复制到 ~/.dsh/.env 后填写。
# 这个文件是唯一一处配置，supervisor 与 dsh 共用。

# 本地桥自己的凭据；dsh 的 apiKeyEnv 读它。不是任何平台的 key。
BRIDGE_API_KEY=change-me

# 桥端口与 CodeBuddy serve 端口
BRIDGE_PORT=8000
CODEBUDDY_SERVE_PORT=8321

# CodeBuddy agent 的工作目录（默认是 dsh 仓库根）
CODEBUDDY_CWD=

# auto / acceptEdits / plan / dontAsk / bypassPermissions
# 注意：default 模式会等客户端批准，而桥没有应答通道，请求会一直挂起。
CODEBUDDY_PERMISSION_MODE=auto

# 可选：覆盖从账号实时发现的模型列表，逗号分隔
CODEBUDDY_MODELS=

# 可选：走内网直连网关时填写；用 CLI 登录态时不要设置
CODEBUDDY_API_KEY=
