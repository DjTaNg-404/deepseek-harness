{
  "name": "@deepseek-ai/dsh-experimental-speech-deepseek-key",
  "description": "Shared DeepSeek credential resolution for the experimental speech providers",
  "version": "0.2.2-alpha.3",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/experimental/speech-deepseek-key" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["locale/*.json", "lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-launch-environment": "workspace:*"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": { "@deepseek-ai/cordis": "workspace:~" }
}
